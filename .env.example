# Copy this file to .env.local and fill in the value. See README.md for
# where to get it. Optional — the site works without it, the contact form
# just shows a fallback message and points to phone/Instagram instead.

NEXT_PUBLIC_WEB3FORMS_KEY=

# My PT Hub's URL is set directly in src/lib/site-config.ts (myPtHubUrl),
# not here, since it's a real stable value rather than a secret.
# NEXT_PUBLIC_CALENDLY_URL= (only used as a fallback if myPtHubUrl is cleared)
